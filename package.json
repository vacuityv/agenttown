    "sync:plugins": "node scripts/sync-plugins.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
